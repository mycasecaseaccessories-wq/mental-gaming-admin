{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.ts": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/catalogs", "destination": "/index.html" }
  ]
}
