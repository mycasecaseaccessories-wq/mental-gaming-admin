{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["client/src/*"] }
  },
  "include": ["index.ts", "vite.config.ts", "client/src/**/*.ts", "client/src/**/*.tsx", "server/**/*.ts"],
  "exclude": ["node_modules", "public", "**/*.test.ts"]
}
